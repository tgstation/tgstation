/**
 * # Techweb Node
 *
 * A datum representing a researchable node in the techweb.
 *
 * Techweb nodes are GLOBAL, there should only be one instance of them in the game. Persistant
 * changes should never be made to them in-game. USE SSRESEARCH PROCS TO OBTAIN REFERENCES.
 */
/datum/techweb_node
	/// The name of the node as it is shown on UIs
	var/display_name = null
	/// A description of the node to show on UIs
	var/description = null
	/// The category of the node
	var/category = "Misc"
	/// Behavior flags for this techweb node.
	var/node_flags = TECHWEB_NODE_WIKI

	/// A list of nodes required to be unlocked to research this node. Made associative in New() for faster lookups.
	var/list/prerequisite_nodes
	/// A list of design typepaths that this node unlocks. Made associative in New() for faster lookups.
	var/list/unlocked_designs
	/// A list of nodes that we unlock. Auto-generated by SSresearch.
	var/list/unlocked_nodes
	/// List of items you need to deconstruct to unlock this node.
	var/list/required_items_to_unlock
	/// The points cost to research the node, type = amount
	var/list/research_costs
	/// The list of experiments required to research the node
	var/list/required_experiments
	/// If completed, these experiments give a specific point amount discount to the node.
	var/list/discount_experiments
	/// Boost quantities from non-experiment sources (i.e., toxins papers).
	/// Indexed by point type to boost amount (with only one boost per point type).
	var/list/discount_boosts
	/// When this node is completed, allows these experiments to be performed.
	var/list/experiments_to_unlock

	/**
	 * If set, the researched node will be announced on these channels by an announcement system
	 * with 'announce_research_node' set to TRUE when researched by the station.
	 * Not every node has to be announced if you want, some are best kept a little "subtler", like Illegal Weapons.
	 */
	var/list/announce_channels

/datum/techweb_node/New()
	. = ..()
	// Make lists associative for faster lookup
	for(var/prerequisite_path in prerequisite_nodes)
		prerequisite_nodes[prerequisite_path] = TRUE
	for(var/design_path in unlocked_designs)
		unlocked_designs[design_path] = TRUE

/datum/techweb_node/Destroy()
	SSresearch.techweb_nodes -= type
	return ..()

/datum/techweb_node/proc/get_price(datum/techweb/host)
	if(!host)
		return research_costs

	var/list/actual_costs = LAZYCOPY(research_costs)

	if(LAZYLEN(discount_experiments))
		for(var/cost_type in actual_costs)
			for(var/experiment_type, discount_amount in discount_experiments)
				if(host.completed_experiments[experiment_type]) //do we have this discount_experiment unlocked?
					actual_costs[cost_type] -= discount_amount

	if(LAZYLEN(discount_boosts) && host.boosted_nodes[type]) // Boosts should be subservient to experiments.
		for(var/boost_type, boost_amount in discount_boosts)
			if(actual_costs[boost_type])
				actual_costs[boost_type] = max(actual_costs[boost_type] - boost_amount, 0)

	return actual_costs

/// If this node requires 0 points to research
/datum/techweb_node/proc/is_free(datum/techweb/host)
	return !values_sum(get_price(host))

/datum/techweb_node/proc/price_display(datum/techweb/techweb)
	return techweb_point_display_generic(get_price(techweb))

///Proc called when the Station (Science techweb specific) researches a node.
/datum/techweb_node/proc/on_station_research(atom/research_source)
	SHOULD_CALL_PARENT(TRUE)
	var/list/channels_to_use = announce_channels
	if(istype(research_source, /obj/machinery/computer/rdconsole))
		var/obj/machinery/computer/rdconsole/console = research_source
		var/obj/item/circuitboard/computer/rdconsole/board = console.circuit
		if(board.silence_announcements)
			return
		if(board.obj_flags & EMAGGED)
			channels_to_use = list(RADIO_CHANNEL_COMMON)
	if(length(channels_to_use) && !(node_flags & TECHWEB_NODE_STARTER))
		aas_config_announce(/datum/aas_config_entry/researched_node, list("NODE" = display_name), null, channels_to_use)
