			"type": "auxtools",
			"request": "launch",
			"name": "Launch DreamDaemon (With selected flags)",
			"preLaunchTask": "Build All",
			"dmb": "${workspaceFolder}/${command:dreammaker.getFilenameDmb}",
			"server": "dreamdaemon",
			"defines": ["CBT"]
		},
		{
			"type": "auxtools",
