				"CBT",
				"SKIP_LAVALAND",
				"SKIP_SPACE_LEVELS",
				"TESTING",
				"REAGENTS_TESTING",
				"TIMER_DEBUG",
				"REFERENCE_DOING_IT_LIVE",
				"FORCE_MAP=\"runtimestation\""
			]
		},
		{
			"type": "auxtools",
